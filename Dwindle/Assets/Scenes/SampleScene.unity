  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "BOARDS, DOORS, DWINDLE, AND RECOVERY\r\n\r\nBoards\r\nSome levels have
    two or more boards. An object's ring can be on a different board from where it
    starts.\r\n\r\nDoors\r\nDoors with the same letter are linked, in both directions,
    and any object can use any door.\r\n\u2022 A road that leads onto a door takes
    the object through it and out of the matching door.\r\n\u2022 Coming out of a
    door between two squares, choose which way the object faces.\n\nAfter a Delivery\nEvery
    time an object reaches its matching ring:\n\u2022 One random tile from its path
    is removed.\n\u2022 One random unused tile is removed from your supply.\nNo tiles
    are removed on the move that completes the level.\n\nRecover a Tile\nIf one placement
    delivers two or more objects and the level continues, choose one tile from the
    Removed panel to recover."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
