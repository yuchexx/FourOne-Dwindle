    m_PersistentCalls:
      m_Calls: []
  m_text: "SCORE AND STARS\n\nPoints\n\u2022 Delivery: +100 per object.\n\u2022 Combo:
    +50 per object when one placement delivers two or more.\n\u2022 Door travel:
    +50 per traversal, awarded upon delivery when the destination board differs from
    the starting board.\n\u2022 Unused supply: +75 per tile, only when every object
    is delivered.\n\nStar Goals\n1st: Deliver all objects but one.\n2nd: Deliver
    every object.\n3rd: Reach the target score.\n\nLevel End\nThe level ends when:\n\u2022
    Every object is delivered.\n\u2022 All remaining objects are blocked or cannot
    reach their destinations.\n\u2022 No supply tiles remain.\n\u2022 No empty playable
    cells remain."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
